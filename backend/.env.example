# ===== AI All-in-One 1.0 环境变量示例 =====
# 复制为 .env，填实际值，再 `docker compose up -d`

# ---- 必填 ----

# Master Key（用于 AES-256-GCM 加密用户 API Key）
# 必须是 32 字节（base64 解码后）
# 生成：openssl rand -base64 32
AIIO_MASTER_KEY=0123456789abcdef0123456789abcdef

# JWT 签名密钥（1.0 简化校验，2.0 接真 JWT）
# 生成：openssl rand -hex 32
AIIO_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ---- 可选 ----

# 开发模式鉴权 token（用户从浏览器调 API 时带的 Bearer）
# 1.0 简化：所有非空 Bearer 都放行
# 2.0 接 JWT 后可移除
AIIO_AUTH_TOKEN=devtoken

# 监听地址（容器内默认 :8080）
AIIO_LISTEN=:8080

# 数据目录（keyring.json 落这里）
# 容器内默认 /data，挂载到 aiio-data volume
